MALWAREBAZAAR_AUTH_KEY=
MISP_KEY=
MISP_URL=
MISP_VERIFY_CERT=
DB_PATH=data/wraithfeed.db
# Where `run --write` saves a JSON artifact per finding
# WRAITHFEED_ARTIFACT_DIR=data/findings
# LLM providers: anthropic | openai | openrouter | local | ollama
# WRAITHFEED_LLM_* applies to every stage; WRAITHFEED_<STAGE>_* overrides one stage.
WRAITHFEED_TRIAGE_PROVIDER=anthropic
WRAITHFEED_TRIAGE_MODEL=claude-haiku-4-5
# WRAITHFEED_TRIAGE_BASE_URL=   # only for openai-compatible/local/ollama overrides
# Stage 6 (structure). Ollama needs a context window big enough for article + candidates.
# WRAITHFEED_STRUCTURE_PROVIDER=ollama
# WRAITHFEED_STRUCTURE_MODEL=qwen3.5:latest
# WRAITHFEED_STRUCTURE_NUM_CTX=12288
# WRAITHFEED_STRUCTURE_TIMEOUT=300
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
